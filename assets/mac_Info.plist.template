<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference fragment. build.py merges an equivalent structure into the generated
  dist/EMPViewer.app/Contents/Info.plist automatically after PyInstaller runs.
  Kept here so the document-type registration is reviewable in source.

  CFBundleDocumentTypes is what makes Finder route a double-clicked .eml/.msg/
  .pst/.ost to EMPViewer as a QFileOpenEvent.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.empviewer.app</string>
    <key>CFBundleName</key>
    <string>EMPViewer</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <!--
      One document type per extension so Finder can show a distinct icon for
      each. build.py copies icons/filetypes/<ext>.icns into
      Contents/Resources/ and sets CFBundleTypeIconFile to match.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>E-mail Message</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>eml.icns</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>eml</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Outlook Message</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>msg.icns</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>msg</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Outlook Data File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>pst.icns</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>pst</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Outlook Offline Data File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>ost.icns</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ost</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
