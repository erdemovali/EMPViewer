__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

build/
dist/
*.spec

.pytest_cache/
.coverage
htmlcov/

# Ignore ad-hoc test data, but keep small curated fixtures (large user PST/OST
# dumps stay out). Note the /* - a bare "tests/data/" can't be un-ignored.
tests/data/*
!tests/data/.gitkeep
!tests/data/README.md
!tests/data/*.tnef

.DS_Store
Thumbs.db

# local scratch
job-logs.txt
*.pdf

# signing material - never commit
*.key
*.p12
*.cer
*.csr
*.pem
*.b64
*.mobileprovision
